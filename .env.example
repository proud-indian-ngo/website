# pi-dash public events feed (proud-indian-ngo/dash#150). When set, the build fetches it, and browsers re-fetch it on
# load (CORS allows proudindian.ngo and *.pages.dev, not localhost). Empty: no sessions; the poster points to the
# dashboard. In CI it is the repository variable PUBLIC_EVENTS_URL.
PUBLIC_EVENTS_URL=https://dash.proudindian.ngo/api/public/events

# Canonical origin for canonical links, Open Graph URLs and the sitemap. Default: https://proudindian.ngo
PUBLIC_SITE_URL=https://proudindian.ngo
