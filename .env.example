# pi-dash public events API (research/pi-dash-public-events-api.md). Leave empty until the endpoint ships: the site
# then shows no sessions, and the poster points to the dashboard.
# When set, the build fetches it, and browsers re-fetch it on load (needs CORS for the site's origin).
PUBLIC_EVENTS_URL=
# PUBLIC_EVENTS_URL=https://dash.proudindian.ngo/api/public/events

# Canonical origin for canonical links, Open Graph URLs and the sitemap. Default: https://proudindian.ngo
PUBLIC_SITE_URL=https://proudindian.ngo
