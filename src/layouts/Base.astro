---
import "../styles/global.css";
import briconFont from "@proudindian/design/fonts/bricolage-grotesque-800-latin.woff2?url";
import geistFont from "@proudindian/design/fonts/geist-latin-wght-normal.woff2?url";
import LogoSprite from "../components/brand/LogoSprite.astro";

interface Props {
  title: string;
  description: string;
  /** keep out of search results (style guide, 404) */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://proudindian.ngo/");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;
---

<!doctype html>
<html lang="en-IN" data-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#4CC0EC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Proud Indian" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Proud Indian: Be an Optimist." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ProudIndianNGO" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      /* Decide motion before first paint: the footer "Pause motion" choice wins, and reduced motion always turns it off. */
      (function () {
        var d = document.documentElement,
          p = null;
        try {
          p = localStorage.getItem("pi-motion-paused");
        } catch (e) {}
        d.dataset.motion = p === "1" || matchMedia("(prefers-reduced-motion: reduce)").matches ? "off" : "on";
        d.classList.add("js");
        /* macOS keeps the system's own scrollbars: html[data-native-scrollbar] switches off every rule in
           @proudindian/design/scrollbar.css. iPadOS reports "MacIntel" but has touch points, so it is not a Mac. */
        var n = navigator,
          ua = n.userAgentData;
        if ((ua && ua.platform ? ua.platform === "macOS" : /Mac/.test(n.platform || n.userAgent)) && !(n.maxTouchPoints > 1))
          d.setAttribute("data-native-scrollbar", "");
      })();
    </script>
    <link rel="preload" href={briconFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <LogoSprite />
    <slot />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
