---
/** The two cut-out kids, the sun and the sparkle beside the volunteer guide's and /csr/'s hero headings
 *  (positions in volunteer-page.css, .vg-kids). */
import type { ImageMetadata } from "astro";

import HeroSun from "../doodles/HeroSun.astro";
import Sparkle from "../doodles/Sparkle.astro";
import Sticker from "./Sticker.astro";

interface Props {
  kids: { src: ImageMetadata; label: string }[];
}

const [k1, k2] = Astro.props.kids;
---

<div class="vg-kids" data-stagger="0">
  <HeroSun class="sun loop vg-sun overflow-visible" aria-hidden="true" />
  <Sparkle class="vg-spark" data-reveal="slap" data-at="700" aria-hidden="true" />
  {
    k1 && (
      <Sticker
        class="vg-k1 wob"
        src={k1.src}
        alt={k1.label}
        width={300}
        phone="44vw"
        eager
        data-reveal="slap"
        data-at="300"
      />
    )
  }
  {
    k2 && (
      <Sticker
        class="vg-k2 wob"
        src={k2.src}
        alt={k2.label}
        width={280}
        phone="40vw"
        eager
        data-reveal="slap"
        data-at="480"
      />
    )
  }
</div>
