---
/**
 * Every raster image on the site goes through here: AVIF via <picture> with a JPG/PNG fallback, responsive widths,
 * lazy loading by default. (No WebP: every browser that has WebP but not AVIF is old enough to take the fallback, and
 * the extra <source> cost HTML bytes on every image.) `phone` is the image's width on phones (700px and below) as a
 * CSS length, e.g. "41vw" or "216px", so phones fetch the right file instead of the desktop size. <picture> is
 * display:contents (base.css), so the prototype CSS that targets the
 * <img> keeps working unchanged.
 */
import type { ImageMetadata } from "astro";
import { PHONE_MAX } from "@proudindian/design/tokens";
import { Picture } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & {
  src: ImageMetadata;
  alt: string;
  /** the largest CSS width (px) this image is shown at; 1x, 1.5x and 2x variants are generated */
  width: number;
  /** the width on phones (700px and below), as a CSS length ("41vw", "216px"); defaults to `width` */
  phone?: string;
  /** above the fold: load eagerly with high priority */
  eager?: boolean;
};

const { src, alt, width, phone, eager = false, ...rest } = Astro.props;
const widths = [...new Set([1, 1.5, 2].map((k) => Math.min(Math.round(width * k), src.width)))].toSorted((a, b) => a - b);
const sizes = phone ? `(max-width: ${PHONE_MAX}px) ${phone}, ${width}px` : `${width}px`;
const fallbackFormat = src.format === "png" ? "png" : "jpg";
---

<Picture
  src={src}
  alt={alt}
  formats={["avif"]}
  fallbackFormat={fallbackFormat}
  widths={widths}
  sizes={sizes}
  loading={eager ? "eager" : "lazy"}
  decoding={eager ? "sync" : "async"}
  fetchpriority={eager ? "high" : undefined}
  {...rest}
/>
