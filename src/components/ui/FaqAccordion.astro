---
/** An FAQ as an accordion of <details> (open without JavaScript, every answer in the HTML for search engines and
 *  agents), the first one open. Used by the volunteer guide and /csr/; styles in volunteer-page.css (.vg-q). */
interface Props {
  /** the questions with their answers already rendered (src/lib/inline.ts) */
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="vg-qs mt-12 grid gap-3.5 max-tab:mt-9">
  {
    items.map((it, i) => (
      <details class="vg-q" open={i === 0}>
        <summary>
          <span>{it.q}</span>
          <span class="vg-q-ic" aria-hidden="true" />
        </summary>
        <p set:html={it.a} />
      </details>
    ))
  }
</div>
