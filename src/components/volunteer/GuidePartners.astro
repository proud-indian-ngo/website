---
/** Partners in a section of their own: on the volunteer guide before the closing, and on /csr/ before the paperwork.
 *  The home page's partner logos (Partners.astro). Logos: src/content/partners.yaml. Copy: copy.yaml → partners. */
import Partners from "../sections/Partners.astro";

interface Props {
  /** the "Partner with us" link under the logos (off on /csr/, which is where it goes) */
  cta?: boolean;
}

const { cta = true } = Astro.props;
---

<section
  class="vg-partners relative border-t-line border-ink bg-paper px-14 pt-28 pb-32 max-tab:px-5 max-tab:pt-18 max-tab:pb-20"
  id="partners"
  aria-labelledby="partners-h"
>
  <div class="relative z-2 mx-auto max-w-section">
    <Partners level="h2" cta={cta} />
  </div>
</section>
