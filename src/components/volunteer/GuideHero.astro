---
/**
 * Guide hero: "Weekend volunteering in Bengaluru." on cyan, with a pinboard beside it: two photos of Optimists with
 * the children and the fine print on a notepad (18 and over, free, weekends), pinned over them. The calls to action
 * (and an optional donate link) sit under the lede. Used by /volunteer/ (volunteer.yaml → hero) and the programme pages
 * (programme-pages/*.yaml → hero). Layout: volunteer-page.css (.vg-board, and .vg-pad, the notepad the FAQ is written
 * on too).
 */
import type { CollectionEntry } from "astro:content";
import { getSite } from "../../lib/content";
import { asset } from "../../lib/images";
import HandsUp from "../doodles/HandsUp.astro";
import HeroSun from "../doodles/HeroSun.astro";
import MarginDoodles from "../margins/MarginDoodles.astro";
import AccentWord from "../ui/AccentWord.astro";
import Button from "../ui/Button.astro";
import Polaroid from "../ui/Polaroid.astro";

interface Props {
  hero: CollectionEntry<"volunteer">["data"]["hero"];
}

const { hero: h } = Astro.props;
const site = await getSite();
const [p1, p2] = h.photos;
---

<div class="s-hero relative" id="top">
  <section
    class="vg-hero relative overflow-hidden bg-sky px-14 pt-[150px] pb-28 max-tab:px-5 max-tab:pt-[104px] max-tab:pb-16"
    aria-labelledby="vg-h"
  >
    <MarginDoodles set="vhero" tone="sky" />
    <div class="vg-grid relative z-2 mx-auto max-w-section">
      <div data-stagger="80">
        <p
          class="mb-6 inline-flex items-center gap-2 rounded-pill border-line border-ink bg-white py-1 pr-3.5 pl-1.5 font-pi-sans text-15 font-semibold"
          data-reveal="rise"
        >
          <HandsUp class="pi-doodle w-[26px]" aria-hidden="true" />{h.eyebrow}
        </p>
        <h1
          id="vg-h"
          class="vg-h1 font-pi-display leading-[.88] font-extrabold tracking-poster text-balance"
          data-reveal="wipe"
        >
          {h.heading.before} <AccentWord variant="outline" class="relative inline-block">{h.heading.accent}</AccentWord>
        </h1>
        <p
          class="mt-7 max-w-[46ch] font-pi-sans text-20 leading-lede text-pretty max-tab:mt-5 max-tab:text-17"
          data-reveal="rise"
        >
          {h.lede}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3 max-tab:mt-6" data-reveal="rise">
          <Button href={site.links.register} size="lg" arrow>{h.join}</Button>
          <Button href="#volunteer" variant="ghost" size="lg">{h.sessions}</Button>
        </div>
        {
          h.donate && (
            <p class="mt-5" data-reveal="rise">
              <a
                class="tap-44 font-pi-sans text-16 font-semibold text-ink underline decoration-[1.5px] underline-offset-4"
                href="/#donate"
              >
                {h.donate} <span aria-hidden="true">→</span>
              </a>
            </p>
          )
        }
      </div>
      <div class="vg-board" data-stagger="0">
        <HeroSun class="sun loop vg-sun overflow-visible" aria-hidden="true" />
        {
          p1 && (
            <div class="vg-ph vg-ph1 wob" data-reveal="slap" data-at="240">
              <span class="pi-tape tape" aria-hidden="true" />
              <Polaroid src={asset(p1.image)} alt={p1.alt} width={300} phone="54vw" caption={p1.caption} />
            </div>
          )
        }
        {
          p2 && (
            <div class="vg-ph vg-ph2 wob" data-reveal="slap" data-at="400">
              <span class="pi-tape tape" aria-hidden="true" />
              <Polaroid src={asset(p2.image)} alt={p2.alt} width={240} phone="44vw" caption={p2.caption} />
            </div>
          )
        }
        <div class="vg-pad vg-note" data-reveal="slap" data-at="560">
          <span class="vg-tack" aria-hidden="true"></span>
          <p class="font-pi-display text-26 leading-none font-extrabold tracking-heading">{h.factsTitle}</p>
          <ul class="mt-3" aria-label={h.factsTitle}>
            {
              h.facts.map((f) => (
                <li class="vg-line flex items-center gap-2.5 font-pi-sans text-16 font-semibold">
                  <svg viewBox="0 0 20 20" class="vg-tick size-5 flex-none" aria-hidden="true">
                    <circle cx="10" cy="10" r="8.6" />
                    <path d="M6.2 10.4L8.8 12.9L13.9 7.4" />
                  </svg>
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</div>
