---
/** /kalakriti/, "Moments from 20 September.": the home band's festival clothesline on marigold, eight polaroids from
 *  the last edition pegged four to a string under the bunting (one swipeable line on phones). The line's layout, sway
 *  and swipe are the home band's (.s-kala, sections/kalakriti.css, scripts/swipe.ts); the marigold colours are
 *  kalakriti-page.css. Copy: kalakriti-page.yaml → gallery. */
import { getKalakritiPage } from "../../lib/content";
import { asset } from "../../lib/images";
import SwipeArrow from "../doodles/SwipeArrow.astro";
import MarginDoodles from "../margins/MarginDoodles.astro";
import BuntingString from "../scenes/BuntingString.astro";
import Peg from "../ui/Peg.astro";
import Polaroid from "../ui/Polaroid.astro";
import SectionHead from "../ui/SectionHead.astro";

const { gallery: g } = await getKalakritiPage();
const rows = [g.photos.slice(0, 4), g.photos.slice(4, 8)];
---

<div class="s-kala">
  <section
    class="kg relative overflow-hidden border-t-line border-ink bg-marigold px-14 pt-28 pb-32 max-tab:px-5 max-tab:pt-18 max-tab:pb-20"
    id="gallery"
    aria-labelledby="kala-gallery-h"
  >
    <MarginDoodles set="kgallery" tone="sky" />
    <div class="relative z-2 mx-auto max-w-section">
      <SectionHead id="kala-gallery-h" eyebrow={g.eyebrow} heading={g.heading} tone="sky" />
      <div class="kline relative mt-16 max-tab:-mx-5 max-tab:mt-10">
        <div
          class="kl-scroll"
          role="region"
          aria-label={g.regionLabel}
          tabindex="0"
          data-swipe
          data-swipe-prev={g.prev}
          data-swipe-next={g.next}
        >
          {
            rows.map((row) => (
              <div class="kl-row loop">
                <BuntingString class="kl-str" aria-hidden="true" />
                <ul class="kl-hang">
                  {row.map((p, i) => (
                    <li class={`hg h${i + 1}`}>
                      <Peg />
                      <Polaroid
                        class="wob"
                        variant="peg"
                        src={asset(p.image)}
                        alt={p.alt}
                        width={260}
                        phone="120px"
                        caption={p.caption}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p
          class="klswipe hidden items-center gap-1.5 px-5 font-pi-display text-19 font-extrabold tracking-label text-ink max-tab:flex"
          aria-hidden="true"
        >
          {g.swipe}
          <SwipeArrow class="pi-doodle" />
        </p>
      </div>
    </div>
  </section>
</div>
