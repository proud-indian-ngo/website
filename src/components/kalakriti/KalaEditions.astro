---
/** /kalakriti/, "Three Septembers so far.": one taped poster per edition, newest first (a small version of the home
 *  band's festival poster), with its date, venue, photo, numbers, what it cost and raised, and its financial disclosure. Copy: kalakriti-page.yaml → editions. */
import { getKalakritiPage } from "../../lib/content";
import { asset } from "../../lib/images";
import { newTab } from "../../lib/links";
import MarginDoodles from "../margins/MarginDoodles.astro";
import Img from "../ui/Img.astro";
import NewTab from "../ui/NewTab.astro";
import SectionHead from "../ui/SectionHead.astro";

const { editions: e } = await getKalakritiPage();
/** the numbers under the photo; the date and venue are on the poster's head */
const rows = (x: (typeof e.items)[number]) =>
  [
    [e.labels.children, x.children],
    [e.labels.volunteers, x.volunteers],
    [e.labels.cost, x.cost],
    [e.labels.raised, x.raised],
  ].filter((r): r is [string, string] => Boolean(r[1]));
---

<section
  class="relative overflow-hidden border-t-line border-ink bg-paper-2 px-14 pt-28 pb-32 max-tab:px-5 max-tab:pt-18 max-tab:pb-20"
  id="editions"
  data-spy="editions"
  aria-labelledby="kala-editions-h"
>
  <MarginDoodles set="keditions" />
  <div class="relative z-2 mx-auto max-w-section">
    <SectionHead id="kala-editions-h" eyebrow={e.eyebrow} heading={e.heading} lede={e.lede} />
    <ol class="mt-16 grid grid-cols-3 items-start gap-10 max-lap:mx-auto max-lap:max-w-[560px] max-lap:grid-cols-1 max-tab:mt-10 max-tab:gap-12">
      {
        e.items.map((x) => {
          const [word, ...version] = x.name.split(" ");
          return (
            <li class="ked relative flex flex-col border-line border-ink bg-paper px-6 pt-7 pb-6 max-tab:px-5">
              <span class="pi-tape tape" aria-hidden="true" />
              <h3 class="font-pi-display text-52 leading-[.9] font-extrabold tracking-tighter max-tab:text-44">
                {word} <span class="text-sky-ink">{version.join(" ")}</span>
              </h3>
              <p class="mt-3 self-start rounded-4 bg-ink px-2.5 pt-1 pb-1.5 font-pi-display text-17 font-extrabold tracking-label text-paper">
                {x.dateLabel}
              </p>
              <p class="mt-2 font-pi-sans text-15 font-semibold">{x.venue}</p>
              <Img
                src={asset(x.image)}
                alt={x.alt}
                width={420}
                phone="calc(100vw - 80px)"
                class="mt-5 aspect-[3/2] w-full border-line border-ink object-cover"
              />
              <dl class="mt-4 grid grid-cols-2 gap-x-4">
                {rows(x).map(([label, value]) => (
                  <div class="flex items-baseline justify-between gap-2 border-t-line border-ink pt-1 pb-2">
                    <dt class="font-pi-sans text-13 font-semibold tracking-caption">{label}</dt>
                    <dd class="font-pi-display text-22 leading-none font-extrabold tracking-title tabular-nums">{value}</dd>
                  </div>
                ))}
              </dl>
              <p class="mt-3 font-pi-sans text-15 leading-body text-pretty text-text-muted">{x.note}</p>
              <a
                class="mt-4 self-start font-pi-sans text-15 font-bold text-sky-ink underline decoration-1 underline-offset-3"
                href={x.disclosure}
                {...newTab()}
              >
                {e.disclosure}
                <span class="sr-only">: {x.name}</span>
                <NewTab />
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
