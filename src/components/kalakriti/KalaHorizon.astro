---
/** /kalakriti/, "After the stage, a whole year.": Kalakriti Horizon, the year-long training for the children who stand
 *  out at the festival: last year's numbers, the Soorya story, next year's plan and a taped polaroid. On ink, like the
 *  home page's Kalakriti band. Copy: kalakriti-page.yaml → horizon. */
import { getKalakritiPage } from "../../lib/content";
import { asset } from "../../lib/images";
import MarginDoodles from "../margins/MarginDoodles.astro";
import Polaroid from "../ui/Polaroid.astro";
import SectionHead from "../ui/SectionHead.astro";

const { horizon: h } = await getKalakritiPage();
---

<div class="s-kala">
  <section
    class="relative overflow-hidden bg-ink px-14 pt-28 pb-32 text-paper max-tab:px-5 max-tab:pt-18 max-tab:pb-20"
    id="horizon"
    data-spy="horizon"
    aria-labelledby="kala-horizon-h"
  >
    <MarginDoodles set="khorizon" tone="ink" />
    <div class="relative z-2 mx-auto grid max-w-section grid-cols-[minmax(0,1fr)_auto] items-start gap-16 max-lap:grid-cols-1 max-lap:gap-12">
      <div>
        <SectionHead id="kala-horizon-h" eyebrow={h.eyebrow} heading={h.heading} lede={h.lede} tone="ink" />
        <p class="mt-12 font-pi-sans text-14 font-bold tracking-caption text-sky uppercase max-tab:mt-9">{h.yearLabel}</p>
        <ul class="mt-4 grid grid-cols-3 gap-5 max-tab:grid-cols-1 max-tab:gap-4">
          {
            h.stats.map((s) => (
              <li class="rounded-20 border-line border-paper-a60 px-5 pt-4 pb-5">
                <p class="font-pi-display text-44 leading-none font-extrabold tracking-heavy">{s.number}</p>
                <p class="mt-2 font-pi-sans text-15 leading-body font-medium text-pretty text-paper-a90">{s.label}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 max-w-[60ch] font-pi-sans text-19 leading-lede font-semibold text-pretty max-tab:text-17">{h.story}</p>
        <p class="mt-3 max-w-[60ch] font-pi-sans text-17 leading-body text-pretty text-paper-a90">{h.next}</p>
      </div>
      <div class="kala-pol wob max-lap:mx-auto">
        <span class="pi-tape tape" aria-hidden="true" />
        <Polaroid src={asset(h.photo.image)} alt={h.photo.alt} width={300} phone="70vw" caption={h.photo.caption} />
      </div>
    </div>
  </section>
</div>
