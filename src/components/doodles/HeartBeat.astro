---
/** Gather doodle: heart that beats (.beat) and sends off a tiny heart (.mini).
 *  Inline SVG; per-use classes and data-reveal attributes come in as props. */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"svg"> & Record<`data-${string}`, string | boolean | undefined>;
---

<svg viewBox="0 0 100 100" {...Astro.props}><path class="pi-ln beat" fill="#F4A62A" d="M50 86C30 72 10 58 11 36C12 22 26 14.5 37.5 19C44 21.5 48 27 50 32C52.5 25 58 19.5 66 18C79 16 90 25.5 89 40C87.5 60 68 74 50 86Z"></path><g class="mini"><path class="pi-ln" style="stroke-width:5" transform="translate(84 2) scale(.24)" d="M50 86C30 72 10 58 11 36C12 22 26 14.5 37.5 19C44 21.5 48 27 50 32C52.5 25 58 19.5 66 18C79 16 90 25.5 89 40C87.5 60 68 74 50 86Z"></path></g></svg>
