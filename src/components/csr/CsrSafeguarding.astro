---
/** /csr/, "Children first.": the rules everyone who spends time with our children follows. Copy: csr.yaml →
 *  safeguarding. */
import { getCsrPage } from "../../lib/content";
import MarginDoodles from "../margins/MarginDoodles.astro";
import CsrHead from "./CsrHead.astro";

const { safeguarding: s } = await getCsrPage();
---

<section
  class="csr-safe relative overflow-hidden border-t-line border-ink bg-paper-2 px-14 pt-28 pb-32 max-tab:px-5 max-tab:pt-18 max-tab:pb-20"
  id="safeguarding"
  aria-labelledby="csr-safe-h"
>
  <MarginDoodles set="csafe" />
  <div class="relative z-2 mx-auto grid max-w-section grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] items-start gap-16 max-lap:grid-cols-1 max-lap:gap-10">
    <CsrHead id="csr-safe-h" eyebrow={s.eyebrow} heading={s.heading} lede={s.lede} />
    <ul class="pi-card grid gap-0 py-3" data-stagger="50">
      {
        s.rules.map((r) => (
          <li
            class="flex items-start gap-3.5 border-b-line border-ink-a14 py-4 font-pi-sans text-17 leading-body font-medium text-pretty last:border-b-0"
            data-reveal="rise"
          >
            <svg viewBox="0 0 20 20" class="vg-tick mt-0.5 size-5.5 flex-none" aria-hidden="true">
              <circle cx="10" cy="10" r="8.6" />
              <path d="M6.2 10.4L8.8 12.9L13.9 7.4" />
            </svg>
            <span>{r}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
