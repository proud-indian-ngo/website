---
/** /csr/, "Ready for your due diligence.": the registrations (CSR-1 first) with their certificates as PDFs
 *  (site.yaml → certificates), the latest audited financials and annual report (newest in reports.yaml), a link to every
 *  report on the home page, and how to get the rest of the onboarding documents.
 *  Copy: csr.yaml → paperwork; values from site.yaml. */
import { fill, getCsrPage, getReports, getSite } from "../../lib/content";
import { inline } from "../../lib/inline";
import MarginDoodles from "../margins/MarginDoodles.astro";
import SectionHead from "../ui/SectionHead.astro";

interface Props {
  /** {placeholders} for the copy */
  values: Record<string, string>;
}

const { values } = Astro.props;
const { paperwork: p } = await getCsrPage();
const reports = await getReports();
const { certificates } = await getSite();
// getReports() is newest first
const audited = reports.find((d) => d.kind === "audited");
const annual = reports.find((d) => d.kind === "annual");
const docs = [
  audited && { label: `${p.latestAudited}, ${audited.year}`, href: audited.url },
  annual && { label: `${p.latestAnnual}, ${annual.year}`, href: annual.url },
  { label: p.all, href: "/#reports" },
].filter((d): d is { label: string; href: string } => Boolean(d));
---

<section
  class="csr-docs relative overflow-hidden border-t-line border-ink bg-paper-2 px-14 pt-28 pb-32 max-tab:px-5 max-tab:pt-18 max-tab:pb-20"
  id="paperwork"
  data-spy="paperwork"
  aria-labelledby="csr-docs-h"
>
  <MarginDoodles set="cdocs" />
  <div class="relative z-2 mx-auto max-w-section">
    <SectionHead id="csr-docs-h" eyebrow={p.eyebrow} heading={p.heading} lede={p.lede} />
    <div class="mt-14 grid grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] items-start gap-6 max-lap:grid-cols-1 max-tab:mt-10 max-tab:gap-4.5">
      <div class="rounded-20 border-line border-ink bg-white px-6.5 pt-6 pb-4 shadow-photo max-tab:px-5" data-reveal="rise">
        <p
          class="mb-2 inline-block rounded-3 bg-ink px-[11px] pt-[5px] pb-1 font-pi-sans text-13 font-bold tracking-stamp text-paper uppercase"
        >
          {p.registrationsLabel}
        </p>
        <dl>
          {
            p.items.map((i) => (
              <div class="flex items-baseline justify-between gap-4 border-b-line border-ink-a14 py-3 last:border-b-0 max-tab:flex-col max-tab:gap-0.5">
                <dt class="shrink-0 font-pi-sans text-14 font-semibold tracking-caption text-sky-ink">{i.label}</dt>
                <dd class="text-right font-pi-sans text-17 leading-[1.25] font-bold max-tab:text-left">
                  {fill(i.value, values)}
                  {(i.note || i.cert) && (
                    <span class="mt-1 block text-14 leading-snug font-medium text-text-muted">
                      {i.note}
                      {i.note && i.cert && <span aria-hidden="true"> · </span>}
                      {i.cert && (
                        <a class="font-semibold text-ink underline decoration-1 underline-offset-3" href={certificates[i.cert]} aria-label={`${i.label} certificate (${p.pdf})`}>
                          {p.pdf}
                        </a>
                      )}
                    </span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="pi-card flex flex-col gap-4" data-reveal="rise">
        <p class="font-pi-display text-26 leading-[1.05] font-extrabold tracking-heading">{p.documentsLabel}</p>
        <ul class="grid gap-2.5">
          {
            docs.map((d) => (
              <li>
                <a
                  class="flex items-center justify-between gap-3 rounded-14 border-line border-ink bg-paper px-4 py-3 font-pi-sans text-16 font-semibold no-underline hover-fine:bg-sky"
                  href={d.href}
                >
                  <span>{d.label}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="font-pi-sans text-15 leading-body text-pretty text-text-muted [&_a]:font-semibold [&_a]:text-ink [&_a]:underline" set:html={inline(p.certificates, values)} />
      </div>
    </div>
  </div>
</section>
