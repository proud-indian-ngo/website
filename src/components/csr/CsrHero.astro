---
/**
 * /csr/ hero: the calm one. "CSR and employee volunteering in Bengaluru." on paper, the two calls to action (a
 * pre-filled email and the ways to fund), and the registrations a CSR team checks first as rubber stamps: CSR-1 and
 * NGO Darpan under the buttons, 80G and 12A stamped over a team day printed like a page of the report we send
 * afterwards. Copy: csr.yaml → hero. Layout: csr-page.css (.ch-*).
 */
import { fill, getCsrPage } from "../../lib/content";
import { asset } from "../../lib/images";
import MarginDoodles from "../margins/MarginDoodles.astro";
import Button from "../ui/Button.astro";
import HeroHeading from "../ui/HeroHeading.astro";
import Img from "../ui/Img.astro";

interface Props {
  /** {placeholders} for the copy */
  values: Record<string, string>;
  /** the pre-filled email behind "Plan a volunteering day" */
  plan: string;
}

const { values, plan } = Astro.props;
const { hero: h } = await getCsrPage();
const st = h.stamps;
---

<div class="s-hero relative" id="top">
  <section
    class="relative overflow-hidden bg-paper px-14 pt-[150px] pb-28 max-tab:px-5 max-tab:pt-[104px] max-tab:pb-16"
    aria-labelledby="csr-h"
  >
    <MarginDoodles set="chero" />
    <div class="ch-grid relative z-2 mx-auto max-w-section">
      <div data-stagger="80">
        <p
          class="mb-6 inline-flex rounded-pill border-line border-ink bg-white px-3.5 py-1 font-pi-sans text-15 font-semibold"
          data-reveal="rise"
        >
          {h.eyebrow}
        </p>
        <HeroHeading id="csr-h" heading={h.heading} lede={h.lede} class="csr-h1" />
        <div class="mt-8 flex flex-wrap items-center gap-3 max-tab:mt-6" data-reveal="rise">
          <Button href={plan} size="lg" arrow>{h.plan}</Button>
          <Button href="#ways" variant="ghost" size="lg">{h.fund}</Button>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-3 max-tab:mt-8" data-reveal="rise">
          <ul class="contents" aria-label={st.label}>
            {
              st.rect.map((r) => (
                <li class="ch-stamp ch-stamp--rect">
                  {r.label}
                  <b>{fill(r.value, values)}</b>
                </li>
              ))
            }
          </ul>
          <p class="max-w-[30ch] font-pi-sans text-15 leading-snug font-semibold text-balance text-text-muted">{st.audited}</p>
        </div>
      </div>
      <figure class="ch-report relative border-line border-ink bg-white p-5 pb-4 max-tab:p-3.5" data-reveal="rise">
        <p class="mb-3 flex items-center justify-between font-pi-sans text-13 font-bold tracking-stamp uppercase">
          <span>{h.photo.kicker}</span><span class="text-text-muted" aria-hidden="true">01</span>
        </p>
        <Img
          src={asset(h.photo.image)}
          alt={h.photo.alt}
          width={560}
          phone="calc(100vw - 68px)"
          eager
          class="aspect-[3/2] w-full border-line border-ink object-cover"
        />
        <figcaption class="mt-3 font-pi-sans text-14 leading-snug font-medium text-text-muted">{h.photo.caption}</figcaption>
        <ul class="ch-seals" aria-label={st.label}>
          {
            st.round.map((r) => (
              <li class="ch-stamp ch-stamp--round">
                <b>{fill(r.value, values)}</b>
                {r.label}
              </li>
            ))
          }
        </ul>
      </figure>
    </div>
  </section>
</div>
