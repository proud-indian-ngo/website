---
/** /csr/, "From first email to report.": the steps from an enquiry to the report afterwards, as a timeline on a pale
 *  sky wash: numbered stops on one ruled line, the last one the report. Copy: csr.yaml → how. Layout: csr-page.css
 *  (.chw-*). */
import { getCsrPage } from "../../lib/content";
import MarginDoodles from "../margins/MarginDoodles.astro";
import SectionHead from "../ui/SectionHead.astro";

const { how: h } = await getCsrPage();
---

<section
  class="relative overflow-hidden border-t-line border-ink bg-sky-wash px-14 pt-28 pb-32 max-tab:px-5 max-tab:pt-18 max-tab:pb-20"
  id="how"
  aria-labelledby="csr-how-h"
>
  <MarginDoodles set="chow" />
  <div class="relative z-2 mx-auto max-w-section">
    <SectionHead id="csr-how-h" eyebrow={h.eyebrow} heading={h.heading} />
    <ol class="chw-line mt-16 grid grid-cols-4 gap-8 max-lap:grid-cols-2 max-tab:mt-10 max-tab:grid-cols-1 max-tab:gap-0" data-stagger="70">
      {
        h.steps.map((s, i) => (
          <li class="chw-stop relative" data-reveal="rise">
            <span
              class:list={[
                "chw-dot relative z-1 grid size-12 place-items-center rounded-full border-line border-ink font-pi-display text-22 font-extrabold",
                i === h.steps.length - 1 ? "bg-marigold" : "bg-white",
              ]}
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div class="mt-5 max-tab:mt-0">
              <h3 class="font-pi-display text-26 leading-[1.05] font-extrabold tracking-heading">{s.title}</h3>
              <p class="mt-2 max-w-[30ch] font-pi-sans text-16 leading-body text-pretty text-text-muted">{s.line}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
