---
/** /csr/, "From first email to report.": the steps from an enquiry to the report afterwards. Copy: csr.yaml → how. */
import { getCsrPage } from "../../lib/content";
import MarginDoodles from "../margins/MarginDoodles.astro";
import SectionHead from "../ui/SectionHead.astro";

const { how: h } = await getCsrPage();
---

<section
  class="csr-how relative overflow-hidden border-t-line border-ink bg-sky px-14 pt-28 pb-32 max-tab:px-5 max-tab:pt-18 max-tab:pb-20"
  id="how"
  aria-labelledby="csr-how-h"
>
  <MarginDoodles set="chow" tone="sky" />
  <div class="relative z-2 mx-auto max-w-section">
    <SectionHead id="csr-how-h" eyebrow={h.eyebrow} heading={h.heading} tone="sky" />
    <ol class="mt-14 grid grid-cols-4 gap-5 max-lap:grid-cols-2 max-tab:mt-10 max-tab:grid-cols-1 max-tab:gap-4" data-stagger="70">
      {
        h.steps.map((s, i) => (
          <li class="pi-card flex flex-col gap-3" data-reveal="rise">
            <span
              class="grid size-11 place-items-center rounded-full border-line border-ink bg-sky font-pi-display text-22 font-extrabold"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="font-pi-display text-26 leading-[1.05] font-extrabold tracking-heading">{s.title}</h3>
            <p class="font-pi-sans text-16 leading-body font-medium text-pretty">{s.line}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
