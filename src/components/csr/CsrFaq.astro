---
/** /csr/ FAQ: the volunteer guide's accordion (FaqAccordion.astro). The same answers go into the page's FAQPage
 *  structured data. Copy: csr.yaml → faq. */
import { getCsrPage } from "../../lib/content";
import MarginDoodles from "../margins/MarginDoodles.astro";
import FaqAccordion from "../ui/FaqAccordion.astro";
import SectionHead from "../ui/SectionHead.astro";

interface Props {
  /** the questions with their answers already rendered (src/lib/inline.ts) */
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
const { faq: f } = await getCsrPage();
---

<section
  class="csr-faq relative overflow-hidden border-t-line border-ink bg-paper px-14 pt-28 pb-32 max-tab:px-5 max-tab:pt-18 max-tab:pb-20"
  id="faq"
  data-spy="faq"
  aria-labelledby="csr-faq-h"
>
  <MarginDoodles set="cfaq" />
  <div class="relative z-2 mx-auto max-w-[880px]">
    <SectionHead id="csr-faq-h" eyebrow={f.eyebrow} heading={f.heading} />
    <FaqAccordion items={items} />
  </div>
</section>
