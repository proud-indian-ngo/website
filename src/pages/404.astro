---
import HeroSun from "../components/doodles/HeroSun.astro";
import Button from "../components/ui/Button.astro";
import Base from "../layouts/Base.astro";
import { getSite } from "../lib/content";

const site = await getSite();
---

<Base title="Page not found · Proud Indian" description="This page could not be found." noindex>
  <main
    id="main"
    class="s-hero relative flex min-h-dvh flex-col items-start justify-center overflow-hidden bg-sky px-14 py-24 max-tab:px-5"
  >
    <p class="flex items-center gap-4 font-pi-display text-40 leading-none font-extrabold tracking-title max-tab:text-30">
      Lost?<HeroSun class="sun loop w-[90px] overflow-visible max-tab:w-[64px]" aria-hidden="true" />
    </p>
    <h1
      class="giant mt-2 font-pi-display text-[clamp(120px,22vw,320px)] leading-[.82] font-extrabold tracking-tighter text-white"
    >
      404.
    </h1>
    <p class="mt-10 max-w-[38ch] text-19 leading-[1.4] max-tab:text-16-5">
      This page isn’t here. The rest of the site is: our programmes, Kalakriti, and the next weekend to volunteer.
    </p>
    <div class="ctas mt-6 gap-2.5">
      <Button href="/" class="px-5 py-3 text-15" arrow>Back to the home page</Button>
      <Button href={site.links.register} variant="ghost" class="px-5 py-3 text-15">Become an Optimist</Button>
    </div>
  </main>
</Base>
