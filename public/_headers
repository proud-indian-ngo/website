# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/
# Every response: security headers, and HTML revalidates on each visit so content edits show up immediately.
# The CSP allows Cloudflare Web Analytics (enabled for proudindian.ngo in the Cloudflare dashboard): its beacon script
# loads from static.cloudflareinsights.com and reports to cloudflareinsights.com.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://dash.proudindian.ngo https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

# The project's own pages.dev address serves the same site as proudindian.ngo: keep it out of search, so only the real
# domain is indexed. (Branch previews already get X-Robots-Tag: noindex from Cloudflare.)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Hashed build output (JS, CSS, fonts, optimised images): cache for a year, never revalidate.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static files: a day, then revalidate.
/favicon*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/icon-*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/og.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/og/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Report PDFs (public/reports/): the documents never change under a name (a corrected report gets a new file name),
# so cache them for a year. Served inline so they open in the browser's PDF viewer.
/reports/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
  ! Content-Type
  Content-Type: application/pdf
  Content-Disposition: inline

# Link headers for agent discovery (RFC 8288): each page with Markdown points to it (the same as its
# <link rel="alternate" type="text/markdown">), and to /llms.txt, the whole site in Markdown; the home page also to the
# API catalog. A new page with an index.md.ts gets its own block here.
/
  Link: </index.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain", </.well-known/api-catalog>; rel="api-catalog"
/volunteer/
  Link: </volunteer/index.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain"
/privacy/
  Link: </privacy/index.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain"

# The pages as Markdown for agents (src/pages/**/index.md.ts; functions/_middleware.ts serves them at the pages' own
# URLs to `Accept: text/markdown`). Fetched directly, they stay out of search: the HTML page is the one to index.
/index.md
  X-Robots-Tag: noindex
/volunteer/index.md
  X-Robots-Tag: noindex
/privacy/index.md
  X-Robots-Tag: noindex

# API catalog (RFC 9727): the public events feed on dash.proudindian.ngo, with its OpenAPI description and health check.
# Pages already sends Access-Control-Allow-Origin: * on every response, so agents in a browser can read it.
/.well-known/api-catalog
  ! Content-Type
  Content-Type: application/linkset+json
  ! Cache-Control
  Cache-Control: public, max-age=3600
