# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/
# Every response: security headers, and HTML revalidates on each visit so content edits show up immediately.
# The CSP allows Cloudflare Web Analytics (enabled for proudindian.ngo in the Cloudflare dashboard): its beacon script
# loads from static.cloudflareinsights.com and reports to cloudflareinsights.com.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://dash.proudindian.ngo https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build output (JS, CSS, fonts, optimised images): cache for a year, never revalidate.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static files: a day, then revalidate.
/favicon*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/icon-*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/og.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/og/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Report PDFs (public/reports/): the documents never change under a name (a corrected report gets a new file name),
# so cache them for a year. Served inline so they open in the browser's PDF viewer.
/reports/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
  ! Content-Type
  Content-Type: application/pdf
  Content-Disposition: inline
